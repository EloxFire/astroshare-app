{
  "cli": {
    "version": ">= 16.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "testflight-dev": {
      "autoIncrement": true,
      "environment": "development"
    },
    "testflight-prod": {
      "autoIncrement": true,
      "environment": "production"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight-dev": {
      "ios": {
        "ascAppId": "6787407962"
      },
      "android": {
        "applicationId": "fr.eavagliano.astroshare.dev"
      }
    },
    "testflight-prod": {
      "ios": {
        "ascAppId": "6737229342"
      },
    },
    "production": {
      "ios": {
        "ascAppId": "6737229342"
      },
      "android": {
        "applicationId": "fr.eavagliano.astroshare"
      }
    }
  }
}
